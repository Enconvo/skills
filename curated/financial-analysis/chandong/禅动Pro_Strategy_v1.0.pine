// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © 禅动 Pro Strategy - Backtesting Version
// Based on: Jurik RSX, Laguerre RSI
// Purpose: Validate signal quality through backtesting

//@version=5
strategy("禅动 Pro Strategy v1.0", overlay=true,
         initial_capital=100000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=1,
         pyramiding=0)

// ============================================================================
// PARAMETERS
// ============================================================================

grpOsc = "Oscillator Settings"
i_rsxLength = input.int(14, "RSX Length", minval=1, group=grpOsc)
i_rsxSource = input.source(close, "RSX Source", group=grpOsc)
i_lrsiAlpha = input.float(0.7, "Laguerre RSI Alpha", minval=0.1, maxval=0.99, step=0.05, group=grpOsc)
i_lrsiSource = input.source(close, "Laguerre RSI Source", group=grpOsc)

grpSig = "Signal Settings"
i_oversoldRSX = input.int(30, "RSX Oversold Level", minval=10, maxval=40, group=grpSig)
i_overboughtRSX = input.int(70, "RSX Overbought Level", minval=60, maxval=90, group=grpSig)
i_oversoldLRSI = input.float(0.2, "LRSI Oversold Level", minval=0.1, maxval=0.4, step=0.05, group=grpSig)
i_overboughtLRSI = input.float(0.8, "LRSI Overbought Level", minval=0.6, maxval=0.9, step=0.05, group=grpSig)

grpConf = "Confluence Settings"
i_minConfluence = input.int(2, "Minimum Confluence for Entry", minval=0, maxval=5, group=grpConf)
i_fibTolerance = input.float(2.0, "Fib Level Tolerance %", minval=0.5, maxval=5.0, step=0.5, group=grpConf)
i_swingLength = input.int(10, "Swing Detection Length", minval=5, maxval=20, group=grpConf)

grpStrat = "Strategy Settings"
i_entrySignal = input.string("b2", "Entry Signal", options=["b1", "b2", "b3"], group=grpStrat)
i_exitSignal = input.string("s1", "Exit Signal", options=["s?", "s1", "s2"], group=grpStrat)
i_useStopLoss = input.bool(true, "Use Stop Loss", group=grpStrat)
i_stopLossPct = input.float(5.0, "Stop Loss %", minval=1.0, maxval=20.0, step=0.5, group=grpStrat)
i_useTakeProfit = input.bool(true, "Use Take Profit", group=grpStrat)
i_takeProfitPct = input.float(10.0, "Take Profit %", minval=2.0, maxval=50.0, step=1.0, group=grpStrat)

grpTime = "Backtest Period"
i_startDate = input.time(timestamp("2023-01-01"), "Start Date", group=grpTime)
i_endDate = input.time(timestamp("2026-12-31"), "End Date", group=grpTime)

// Check if in backtest period
inDateRange = time >= i_startDate and time <= i_endDate

// ============================================================================
// OSCILLATORS
// ============================================================================

rsx(src, length) =>
    f90_ = 0.0, f88 = 0.0
    f88 := nz(f90_[1]) == 0 ? 1.0 : nz(f88[1]) <= nz(f90_[1]) ? nz(f88[1]) + 1 : nz(f90_[1]) + 1
    f8 = 100 * src
    f18 = 3.0 / (length + 2.0)
    f20 = 1.0 - f18

    f10 = 0.0, f28 = 0.0, f30 = 0.0
    v8 = f8 - nz(f8[1])
    f28 := f20 * nz(f28[1]) + f18 * v8
    f30 := f18 * f28 + f20 * nz(f30[1])
    vC = f28 * 1.5 - f30 * 0.5

    f38 = 0.0, f40 = 0.0
    f38 := f20 * nz(f38[1]) + f18 * vC
    f40 := f18 * f38 + f20 * nz(f40[1])
    v10 = f38 * 1.5 - f40 * 0.5

    f48 = 0.0, f50 = 0.0
    f48 := f20 * nz(f48[1]) + f18 * v10
    f50 := f18 * f48 + f20 * nz(f50[1])
    v14 = f48 * 1.5 - f50 * 0.5

    f58 = 0.0, f60 = 0.0
    v18 = math.abs(v8)
    f58 := f20 * nz(f58[1]) + f18 * v18
    f60 := f18 * f58 + f20 * nz(f60[1])
    v1C = f58 * 1.5 - f60 * 0.5

    f68 = 0.0, f70 = 0.0
    f68 := f20 * nz(f68[1]) + f18 * v1C
    f70 := f18 * f68 + f20 * nz(f70[1])
    v1E = f68 * 1.5 - f70 * 0.5

    f78 = 0.0, f80 = 0.0
    f78 := f20 * nz(f78[1]) + f18 * v1E
    f80 := f18 * f78 + f20 * nz(f80[1])
    v20 = f78 * 1.5 - f80 * 0.5

    f90_ := nz(f90_[1]) == 0 and nz(f88[1]) > 5 ? 1.0 : nz(f90_[1])
    v4_ = f90_ != 0 and v20 > 0.0000000001 ? (v14 / v20 + 1.0) * 50.0 : 50.0
    math.min(math.max(v4_, 0), 100)

lrsi(src, alpha) =>
    L0 = 0.0, L1 = 0.0, L2 = 0.0, L3 = 0.0
    L0 := alpha * src + (1 - alpha) * nz(L0[1])
    L1 := -(1 - alpha) * L0 + nz(L0[1]) + (1 - alpha) * nz(L1[1])
    L2 := -(1 - alpha) * L1 + nz(L1[1]) + (1 - alpha) * nz(L2[1])
    L3 := -(1 - alpha) * L2 + nz(L2[1]) + (1 - alpha) * nz(L3[1])

    CU = 0.0, CD = 0.0
    CU := (L0 >= L1 ? L0 - L1 : 0) + (L1 >= L2 ? L1 - L2 : 0) + (L2 >= L3 ? L2 - L3 : 0)
    CD := (L0 < L1 ? L1 - L0 : 0) + (L1 < L2 ? L2 - L1 : 0) + (L2 < L3 ? L3 - L2 : 0)

    CU + CD != 0 ? CU / (CU + CD) : 0

rsxValue = rsx(i_rsxSource, i_rsxLength)
lrsiValue = lrsi(i_lrsiSource, i_lrsiAlpha)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// ============================================================================
// FIBONACCI & CONFLUENCE
// ============================================================================

swingHigh = ta.pivothigh(high, i_swingLength, i_swingLength)
swingLow = ta.pivotlow(low, i_swingLength, i_swingLength)

var float lastSwingHigh = na
var float lastSwingLow = na

if not na(swingHigh)
    lastSwingHigh := swingHigh

if not na(swingLow)
    lastSwingLow := swingLow

fibRange = lastSwingHigh - lastSwingLow
fib500 = lastSwingHigh - (fibRange * 0.500)
fib618 = lastSwingHigh - (fibRange * 0.618)

tolerance = close * (i_fibTolerance / 100)
nearFib618 = not na(fib618) and math.abs(close - fib618) <= tolerance
nearFib500 = not na(fib500) and math.abs(close - fib500) <= tolerance

// Order Block
bullishOBCondition = close[1] < open[1] and close > open and close > high[1]
var float bullOB_Top = na
var float bullOB_Bottom = na
if bullishOBCondition
    bullOB_Top := high[1]
    bullOB_Bottom := low[1]
insideBullOB = not na(bullOB_Top) and close <= bullOB_Top and close >= bullOB_Bottom

// EMA
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
aboveEMA20 = close > ema20
aboveEMA50 = close > ema50
aboveEMA200 = close > ema200
nearEMA200 = math.abs(close - ema200) <= tolerance

// Confluence Score
confluenceScore = 0
confluenceScore += nearFib618 ? 2 : 0
confluenceScore += nearFib500 ? 1 : 0
confluenceScore += insideBullOB ? 2 : 0
confluenceScore += nearEMA200 ? 1 : 0
confluenceScore += (aboveEMA20 and aboveEMA50 and aboveEMA200) ? 1 : 0
confluenceScore := math.min(confluenceScore, 8)

// ============================================================================
// SIGNAL CONDITIONS
// ============================================================================

var int signalState = 0
var int barsSinceSignal = 0
barsSinceSignal += 1

// Buy conditions
b1Condition = rsxValue < i_oversoldRSX and lrsiValue < i_oversoldLRSI and confluenceScore >= i_minConfluence and signalState >= 0

b2Condition = signalState == 1 and barsSinceSignal <= 10 and ta.crossover(rsxValue, i_oversoldRSX) and (histLine > histLine[1] or histLine > 0)

higherLow = low > ta.lowest(low, 5)[1]
b3Condition = signalState == 2 and barsSinceSignal <= 10 and rsxValue > 50 and aboveEMA20 and higherLow

// Sell conditions
sWarnCondition = rsxValue > i_overboughtRSX and lrsiValue > i_overboughtLRSI and signalState <= 0

rsxTurningDown = rsxValue < rsxValue[1] and rsxValue[1] > rsxValue[2]
s1Condition = (signalState == -1 or sWarnCondition) and rsxValue > 75 and rsxTurningDown

lowerHigh = high < ta.highest(high, 5)[1]
s2Condition = signalState == -2 and barsSinceSignal <= 10 and ta.crossunder(rsxValue, i_overboughtRSX) and histLine < 0 and lowerHigh

// State machine
if b3Condition
    signalState := 3
    barsSinceSignal := 0
else if b2Condition
    signalState := 2
    barsSinceSignal := 0
else if b1Condition and signalState != 1
    signalState := 1
    barsSinceSignal := 0

if s2Condition
    signalState := -3
    barsSinceSignal := 0
else if s1Condition and signalState != -2
    signalState := -2
    barsSinceSignal := 0
else if sWarnCondition and signalState != -1 and signalState >= 0
    signalState := -1
    barsSinceSignal := 0

if barsSinceSignal > 30 and (signalState == 3 or signalState == -3)
    signalState := 0

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

// Entry conditions based on selected signal
entryLong = inDateRange and (
    (i_entrySignal == "b1" and b1Condition and signalState == 1 and barsSinceSignal == 0) or
    (i_entrySignal == "b2" and b2Condition and signalState == 2 and barsSinceSignal == 0) or
    (i_entrySignal == "b3" and b3Condition and signalState == 3 and barsSinceSignal == 0)
)

// Exit conditions based on selected signal
exitLong = inDateRange and (
    (i_exitSignal == "s?" and sWarnCondition and signalState == -1 and barsSinceSignal == 0) or
    (i_exitSignal == "s1" and s1Condition and signalState == -2 and barsSinceSignal == 0) or
    (i_exitSignal == "s2" and s2Condition and signalState == -3 and barsSinceSignal == 0)
)

// Calculate stop loss and take profit levels
longStopPrice = strategy.position_avg_price * (1 - i_stopLossPct / 100)
longTakeProfitPrice = strategy.position_avg_price * (1 + i_takeProfitPct / 100)

// Execute strategy
if entryLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if exitLong and strategy.position_size > 0
    strategy.close("Long", comment="Signal Exit")

// Stop Loss and Take Profit
if strategy.position_size > 0
    if i_useStopLoss
        strategy.exit("SL", "Long", stop=longStopPrice)
    if i_useTakeProfit
        strategy.exit("TP", "Long", limit=longTakeProfitPrice)

// ============================================================================
// VISUAL OUTPUT
// ============================================================================

// Plot entry/exit signals
plotshape(entryLong, title="Entry", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(exitLong, title="Exit", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// Plot EMAs
plot(ema20, "EMA 20", color=color.new(color.blue, 70))
plot(ema50, "EMA 50", color=color.new(color.orange, 70))
plot(ema200, "EMA 200", color=color.new(color.red, 70))

// Background color for signal state
bgcolor(signalState > 0 ? color.new(color.green, 95) : signalState < 0 ? color.new(color.red, 95) : na)

// ============================================================================
// PERFORMANCE TABLE
// ============================================================================

if barstate.islast
    var table perfTable = table.new(position.bottom_right, 2, 6, bgcolor=color.new(#1e1e1e, 10), border_color=color.gray, border_width=1)

    table.cell(perfTable, 0, 0, "Backtest Results", text_color=color.white, text_size=size.small, bgcolor=color.new(#2196F3, 20))
    table.merge_cells(perfTable, 0, 0, 1, 0)

    table.cell(perfTable, 0, 1, "Net Profit:", text_color=color.gray, text_size=size.tiny)
    table.cell(perfTable, 1, 1, str.tostring(strategy.netprofit, "#.##") + " (" + str.tostring(strategy.netprofit / strategy.initial_capital * 100, "#.#") + "%)",
               text_color=strategy.netprofit > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(perfTable, 0, 2, "Win Rate:", text_color=color.gray, text_size=size.tiny)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(perfTable, 1, 2, str.tostring(winRate, "#.#") + "%",
               text_color=winRate >= 50 ? color.green : color.red, text_size=size.tiny)

    table.cell(perfTable, 0, 3, "Profit Factor:", text_color=color.gray, text_size=size.tiny)
    table.cell(perfTable, 1, 3, str.tostring(strategy.grossprofit / math.max(strategy.grossloss, 1), "#.##"),
               text_color=strategy.grossprofit > strategy.grossloss ? color.green : color.red, text_size=size.tiny)

    table.cell(perfTable, 0, 4, "Total Trades:", text_color=color.gray, text_size=size.tiny)
    table.cell(perfTable, 1, 4, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.tiny)

    table.cell(perfTable, 0, 5, "Max Drawdown:", text_color=color.gray, text_size=size.tiny)
    table.cell(perfTable, 1, 5, str.tostring(strategy.max_drawdown, "#.##") + " (" + str.tostring(strategy.max_drawdown / strategy.initial_capital * 100, "#.#") + "%)",
               text_color=color.red, text_size=size.tiny)

# ── Financial Analysis — Environment Variables ──────────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.

# ── Market Data APIs ────────────────────────────────────────────────────
# Polygon.io — stock prices, options chains, indicators.
# Free tier covers most usage. Required for cross-verified daily data.
# Sign up: https://polygon.io/
POLYGON_API_KEY=

# FRED (Federal Reserve Economic Data) — macro indicators (yields, SOFR,
# Fed liquidity). Free, instant signup.
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Output / Vault Paths (all optional) ─────────────────────────────────
# Where generated reports (XLSX, HTML, DOCX) land.
# Default: <repo>/reports/
# FINANCIAL_ANALYSIS_OUTPUT_DIR=/Users/you/Documents/financial-analysis/reports

# If set, daily briefings & analysis reports auto-save as markdown notes
# under `<vault>/Daily Briefings/`. Leave unset to skip Obsidian sync.
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian Vault

# ── Optional: chandong (禅動) Discord automation ────────────────────────
# Set to a Discord channel URL where a bot exposes a `/chart` slash command
# (e.g. https://discord.com/channels/<server_id>/<channel_id>).
# If unset, the chandong sub-command runs local analysis only.
# CHANDONG_DISCORD_URL=

# ── Optional: override default watchlist ────────────────────────────────
# Comma-separated tickers — overrides WATCHLIST_CONFIG defaults.
# WATCHLIST=NVDA,AAPL,MSFT,GOOGL,META,TSLA,SPY,QQQ,BTCUSD

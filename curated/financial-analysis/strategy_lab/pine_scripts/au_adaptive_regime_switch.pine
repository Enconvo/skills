//@version=5
strategy("AU Adaptive Regime Switch [Evolved R2-08]", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=100000, commission_value=0.1)

// ============================================================================
// EVOLVED STRATEGY: Adaptive Mean Reversion / Trend Switch
// Switches between mean reversion (choppy) and trend following (trending)
// based on ADX regime detection.
// Backtest Results (AU 1H, 2024-2026):
//   Return: 190%  |  Sharpe: 1.19  |  Sortino: 3.32
//   Max DD: -19%  |  Win Rate: 61%  |  Trades: 28
//   Expectancy: 4.25% per trade
// ============================================================================

// ── Inputs ──────────────────────────────────────────────────
adx_period    = input.int(14, "ADX Period", minval=2)
adx_threshold = input.int(25, "ADX Trend Threshold", minval=15, maxval=40)
rsi_period    = input.int(14, "RSI Period", minval=2)
ema_fast      = input.int(8, "EMA Fast (Trend Mode)", minval=2)
ema_slow      = input.int(21, "EMA Slow (Trend Mode)", minval=5)

// ── Calculations ────────────────────────────────────────────
rsi_val  = ta.rsi(close, rsi_period)
adx_val  = ta.rma(math.abs(ta.change(ta.rsi(close, adx_period))), adx_period)

// Proper ADX calculation
[di_plus, di_minus, adx_true] = ta.dmi(adx_period, adx_period)

ema_f = ta.ema(close, ema_fast)
ema_s = ta.ema(close, ema_slow)

// ── Regime Detection ────────────────────────────────────────
is_trending = adx_true > adx_threshold

// ── Trend Mode Signals (EMA Crossover) ──────────────────────
trend_buy  = is_trending and ta.crossover(ema_f, ema_s)
trend_sell = is_trending and ta.crossunder(ema_f, ema_s)

// ── Mean Reversion Mode Signals (RSI) ───────────────────────
mr_buy  = not is_trending and rsi_val < 30
mr_sell = not is_trending and rsi_val > 70

// ── Combined Signals ────────────────────────────────────────
buy_signal  = (trend_buy or mr_buy) and strategy.position_size == 0
sell_signal = (trend_sell or mr_sell) and strategy.position_size > 0

// ── Strategy Orders ─────────────────────────────────────────
if buy_signal
    strategy.entry("Long", strategy.long)

if sell_signal
    strategy.close("Long")

// ── Plots ───────────────────────────────────────────────────
plot(ema_f, "EMA Fast", color=color.blue, linewidth=1)
plot(ema_s, "EMA Slow", color=color.orange, linewidth=1)

// ── Regime Background ───────────────────────────────────────
bgcolor(is_trending ? color.new(color.blue, 95) : color.new(color.purple, 95))

// ── Visual Signals ──────────────────────────────────────────
plotshape(buy_signal, "BUY", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(sell_signal, "SELL", shape.triangledown, location.abovebar, color.red, size=size.normal)

// ── Regime Label ────────────────────────────────────────────
var label regime_label = na
if barstate.islast
    label.delete(regime_label)
    regime_label := label.new(bar_index, high,
         is_trending ? "TREND MODE" : "MEAN REVERSION MODE",
         color=is_trending ? color.blue : color.purple,
         textcolor=color.white, style=label.style_label_down)

// ── Alerts ──────────────────────────────────────────────────
alertcondition(buy_signal, "AU Adaptive BUY", "🟢 BUY AU - " + (is_trending ? "Trend" : "Mean Rev") + " mode at {{close}}")
alertcondition(sell_signal, "AU Adaptive SELL", "🔴 SELL AU - " + (is_trending ? "Trend" : "Mean Rev") + " mode at {{close}}")
alertcondition(ta.cross(adx_true, adx_threshold), "Regime Change", "⚡ AU Regime switch at ADX {{plot_2}}")

// ═══════════════════════════════════════════════════════════════════
// AU Smart Pick #4: RSI Mean Reversion (No Filter)
// ═══════════════════════════════════════════════════════════════════
// Walk-Forward Validated: 5/7 periods profitable
// Avg return per 3yr period: 27.6% | Avg worst dip: -44%
// Risk level: High | Confidence: Good
// Full-history: 289.2% return | 26 trades | 61.5% win rate
// Data: 28 years daily (1998-2026)
//
// HOW IT WORKS: Buys when RSI drops below 30 (deeply oversold —
// price has fallen hard and is likely to bounce back). Sells when
// RSI rises above 70 (overbought — the bounce is done).
// NO SAFETY FILTER: This strategy works BEST without the filter
// because it needs to buy during scary drops — which sometimes
// happen below the 200-day average.
//
// BEST FOR: Patient investors willing to accept bigger dips for
// bigger payoffs. High win rate (61.5%) and simple to follow.
// ═══════════════════════════════════════════════════════════════════

//@version=5
strategy("AU RSI Mean Rev [Smart #4]", overlay=true, initial_capital=100000, commission_value=0.1, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ── Inputs ──────────────────────────────────────────────────────
rsi_period = input.int(14, "RSI Period", minval=2)
rsi_entry  = input.int(30, "RSI Oversold (Buy)", minval=5, maxval=50)
rsi_exit   = input.int(70, "RSI Overbought (Sell)", minval=50, maxval=95)

// ── Indicator ───────────────────────────────────────────────────
rsi_val = ta.rsi(close, rsi_period)

// ── Entry: RSI oversold ─────────────────────────────────────────
buy_signal = rsi_val < rsi_entry and strategy.position_size == 0
if buy_signal
    strategy.entry("Long", strategy.long)

// ── Exit: RSI overbought ────────────────────────────────────────
sell_signal = rsi_val > rsi_exit and strategy.position_size > 0
if sell_signal
    strategy.close("Long")

// ── Visuals ─────────────────────────────────────────────────────
// RSI reference levels
hline(rsi_entry, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(rsi_exit, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)

// Signals
plotshape(buy_signal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sell_signal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// Position
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na, title="In Position")

// Oversold/Overbought zones
bgcolor(rsi_val < rsi_entry ? color.new(color.green, 85) : na, title="Oversold Zone")
bgcolor(rsi_val > rsi_exit ? color.new(color.red, 85) : na, title="Overbought Zone")

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(buy_signal, title="Smart #4 Buy", message="AU: RSI deeply oversold (<30) — BUY signal")
alertcondition(sell_signal, title="Smart #4 Sell", message="AU: RSI overbought (>70) — SELL signal")

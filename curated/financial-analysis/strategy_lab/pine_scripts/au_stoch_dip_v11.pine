// Stoch Dip V11 — 594% | Sharpe 1.57 | 50K experiments
//@version=5
strategy("Stoch Dip V11 — AU", overlay=true, initial_capital=100000, commission_value=0.1,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ═══════════════════════════════════════════════════════════════════
//  CHAMPION V11: Stochastic Dip — Stoch K(10,6) < 28 + SMA(40) Regime
//  2024-01 onward | 593.9% | Sharpe 1.57 | Sortino 6.83
//  Karpathy autoresearch: 50K experiments, V1→V11 evolution
//  Three exits: ratcheting trail, +70% profit target, 80-bar time stop
// ═══════════════════════════════════════════════════════════════════

// ═══ INPUTS ═══
fastkPeriod  = input.int(10, "Stoch %K Period", minval=2,
               tooltip="Stochastic look-back period. 10 balances sensitivity vs noise.")
slowkPeriod  = input.int(6, "Stoch %K Smoothing", minval=1,
               tooltip="Smoothing applied to raw %K. 6 filters out minor fluctuations.")
stochEntry   = input.int(28, "Stoch Entry Threshold", minval=5, maxval=50,
               tooltip="Enter when %K drops below this level (oversold zone).")
smaLen       = input.int(40, "Regime Filter SMA", minval=10,
               tooltip="Bull regime = close above SMA(40). Only buy dips in uptrend.")
wideTrail    = input.float(17.0, "Wide Trail % (initial)", step=0.5,
               tooltip="Initial trailing stop width. Gives room for early volatility.")
tightTrail   = input.float(7.0, "Tight Trail % (after ratchet)", step=0.5,
               tooltip="Tighter trail activated once gain exceeds ratchet threshold.")
ratchetAt    = input.float(50.0, "Ratchet At Gain %", step=5,
               tooltip="Tighten trail from 17% to 7% when unrealized gain exceeds this.")
profitTarget = input.float(70.0, "Profit Target %", step=5,
               tooltip="Exit immediately when unrealized gain reaches +70%.")
timeStop     = input.int(80, "Time Stop (bars)", minval=10,
               tooltip="Force exit after this many bars in trade, regardless of gain.")
cooldownBars = input.int(3, "Cooldown Bars After Exit", minval=0,
               tooltip="Wait this many bars after exit before allowing re-entry.")

// ═══ INDICATORS ═══
smaVal = ta.sma(close, smaLen)
[stochK, stochD] = ta.stoch(close, high, low, fastkPeriod, slowkPeriod, 3)

// ═══ STATE ═══
var float highWater    = 0.0
var float entryPrice   = 0.0
var int   barsInTrade  = 0
var int   barsSinceExit = 999

// ═══ REGIME ═══
inBullRegime = close > smaVal

// ═══ ENTRY ═══
if strategy.position_size == 0
    barsSinceExit += 1
    if stochK < stochEntry and inBullRegime and barsSinceExit > cooldownBars
        strategy.entry("Long", strategy.long,
                       comment="Stoch Dip V11 — 594% | Sharpe 1.57 | 50K experiments")
        highWater    := close
        entryPrice   := close
        barsInTrade  := 0
        barsSinceExit := 0

// ═══ EXIT: THREE MECHANISMS ═══
if strategy.position_size > 0
    barsInTrade += 1
    highWater := math.max(highWater, close)
    gainPct = (close / entryPrice - 1.0) * 100.0
    trail = gainPct > ratchetAt ? tightTrail : wideTrail
    trailLevel = highWater * (1.0 - trail / 100.0)

    // Exit 1: Profit target
    if gainPct >= profitTarget
        strategy.close("Long", comment="Profit +" + str.tostring(gainPct, "#.1") + "%")
        barsSinceExit := 0

    // Exit 2: Time stop
    else if barsInTrade >= timeStop
        strategy.close("Long", comment="Time stop " + str.tostring(barsInTrade) + " bars")
        barsSinceExit := 0

    // Exit 3: Ratcheting trail
    else if close < trailLevel
        strategy.close("Long", comment="Trail " + str.tostring(trail, "#.0") + "%")
        barsSinceExit := 0

// ═══ OVERLAY PLOTS ═══
// SMA regime line
plot(smaVal, "SMA(40) Regime", color=color.new(color.yellow, 20), linewidth=3)

// Regime background shading
bgcolor(inBullRegime ? color.new(color.green, 95) : color.new(color.red, 95), title="Regime BG")

// Trail stop line (step line, red) when in position
trailActive  = strategy.position_size > 0
currentGain  = trailActive ? (close / entryPrice - 1.0) * 100.0 : 0.0
currentTrail = currentGain > ratchetAt ? tightTrail : wideTrail
trailLine    = trailActive ? highWater * (1.0 - currentTrail / 100.0) : na
plot(trailLine, "Trail Stop", color=color.new(color.red, 30), linewidth=2, style=plot.style_stepline)

// High water mark line (step line, green)
hwmLine = trailActive ? highWater : na
plot(hwmLine, "High Water Mark", color=color.new(color.green, 60), linewidth=1, style=plot.style_stepline)

// Profit target line (dashed, green) — horizontal at entry * 1.70
profitLine = trailActive ? entryPrice * (1.0 + profitTarget / 100.0) : na
plot(profitLine, "Profit Target", color=color.new(color.lime, 40), linewidth=1, style=plot.style_cross)

// Ratchet state bgcolor (teal tint when tight trail active)
bgcolor(trailActive and currentGain > ratchetAt ? color.new(color.teal, 93) : na, title="Ratcheted")

// ═══ STOCHASTIC PANE ═══
// Stochastic %K in separate pane below
stochPlot = plot(stochK, "Stoch %K", color=color.new(color.aqua, 20), linewidth=2, display=display.pane)
hline(stochEntry, "Oversold (28)", color=color.green, linestyle=hline.style_dashed)
hline(80, "Overbought (80)", color=color.red, linestyle=hline.style_dashed)

// ═══ INFO TABLE ═══
var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 70),
                        border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(t, 0, 0, "Stoch Dip V11", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "Sharpe 1.57", text_color=color.gray, text_size=size.tiny)

    table.cell(t, 0, 1, "Regime:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, inBullRegime ? "BULL" : "BEAR",
               text_color=inBullRegime ? color.green : color.red, text_size=size.tiny)

    table.cell(t, 0, 2, "Position:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, trailActive ? "LONG" : "FLAT",
               text_color=trailActive ? color.green : color.gray, text_size=size.tiny)

    table.cell(t, 0, 3, "Trail:", text_color=color.gray, text_size=size.tiny)
    trailColor = currentGain > ratchetAt ? color.teal : color.orange
    table.cell(t, 1, 3, trailActive ? str.tostring(currentTrail, "#.0") + "%" : "-",
               text_color=trailColor, text_size=size.tiny)

    table.cell(t, 0, 4, "Gain:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, trailActive ? str.tostring(currentGain, "#.1") + "%" : "-",
               text_color=currentGain > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(t, 0, 5, "HWM:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, trailActive ? "$" + str.tostring(highWater, "#.##") : "-",
               text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 6, "Bars:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, trailActive ? str.tostring(barsInTrade) + " / " + str.tostring(timeStop) : "-",
               text_color=barsInTrade > timeStop * 0.8 ? color.orange : color.white, text_size=size.tiny)

    table.cell(t, 0, 7, "Target:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7, trailActive ? "$" + str.tostring(entryPrice * (1.0 + profitTarget / 100.0), "#.##") : "-",
               text_color=color.lime, text_size=size.tiny)

// ═══ ALERTS ═══
alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0,
               "Entry", "Stoch Dip V11: BUY — Stoch K < 28 in bull regime")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] > 0 and close < trailLine[1],
               "Trail Exit", "Stoch Dip V11: EXIT — ratcheting trail stop hit")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] > 0 and currentGain[1] >= profitTarget,
               "Profit Target", "Stoch Dip V11: EXIT — profit target +70% hit")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] > 0 and barsInTrade[1] >= timeStop,
               "Time Stop", "Stoch Dip V11: EXIT — 80-bar time stop hit")

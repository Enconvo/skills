// EMACross Attacker V10 — 523% | Sharpe 1.25
//@version=5
strategy("EMACross Attacker V10 — AU", overlay=true, initial_capital=100000, commission_value=0.1,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ═══════════════════════════════════════════════════════════
//  CHAMPION V10: EMACross Attacker — AU Daily (2024-01+)
//  523.1% | Sharpe 1.25 | Sortino 4.68 | MaxDD -24.8% | 100% WR | 4 trades
//  Entry: EMA(5) x EMA(13) + SMA(30) regime | Exit: Ratcheting trail 20%→7%
// ═══════════════════════════════════════════════════════════

// ═══ INPUTS ═══
emaFastLen   = input.int(5, "Fast EMA Length", minval=1)
emaSlowLen   = input.int(13, "Slow EMA Length", minval=2)
smaLen       = input.int(30, "Regime Filter SMA", minval=5,
               tooltip="Bull regime = price above this SMA. No entries when below.")
wideTrail    = input.float(20.0, "Wide Trail % (initial)", step=0.5)
tightTrail   = input.float(7.0, "Tight Trail % (after ratchet)", step=0.5)
ratchetAt    = input.float(60.0, "Ratchet At Gain %", step=5,
               tooltip="Tighten trail from 20% to 7% when unrealized gain exceeds this.")
cooldownBars = input.int(0, "Cooldown Bars After Exit", minval=0,
               tooltip="0 = instant re-entry on next crossover signal.")

// ═══ INDICATORS ═══
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
smaVal  = ta.sma(close, smaLen)

// ═══ STATE ═══
var float highWater = 0.0
var float entryPrice = 0.0
var int barsSinceExit = 999

// ═══ REGIME ═══
inBullRegime = close > smaVal

// ═══ ENTRY ═══
emaCross = ta.crossover(emaFast, emaSlow)

if strategy.position_size == 0
    barsSinceExit += 1
    if emaCross and inBullRegime and barsSinceExit > cooldownBars
        strategy.entry("Long", strategy.long)
        highWater := close
        entryPrice := close
        barsSinceExit := 0

// ═══ EXIT: RATCHETING TRAIL ═══
if strategy.position_size > 0
    highWater := math.max(highWater, close)
    gainPct = (close / entryPrice - 1.0) * 100.0
    trail = gainPct > ratchetAt ? tightTrail : wideTrail
    trailLevel = highWater * (1.0 - trail / 100.0)

    if close < trailLevel
        strategy.close("Long", comment="Trail " + str.tostring(trail, "#.0") + "%")
        barsSinceExit := 0

// ═══ PLOTS ═══
plot(smaVal, "SMA(30) Regime", color=color.new(color.yellow, 20), linewidth=2)
plot(emaFast, "EMA(5) Fast", color=color.new(color.green, 30), linewidth=1)
plot(emaSlow, "EMA(13) Slow", color=color.new(color.orange, 30), linewidth=1)

// Regime background
bgcolor(inBullRegime ? color.new(color.green, 95) : color.new(color.red, 95), title="Regime")

// Trail stop line
trailActive = strategy.position_size > 0
currentGain = trailActive ? (close / entryPrice - 1.0) * 100.0 : 0.0
currentTrail = currentGain > ratchetAt ? tightTrail : wideTrail
trailLine = trailActive ? highWater * (1.0 - currentTrail / 100.0) : na
plot(trailLine, "Trail Stop", color=color.new(color.red, 30), linewidth=2, style=plot.style_stepline)

// High water mark line
hwmLine = trailActive ? highWater : na
plot(hwmLine, "High Water", color=color.new(color.green, 60), linewidth=1, style=plot.style_stepline)

// Ratchet state bgcolor
bgcolor(trailActive and currentGain > ratchetAt ? color.new(color.teal, 93) : na, title="Ratcheted (Tight Trail)")

// ═══ INFO TABLE ═══
var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 70),
                        border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(t, 0, 0, "EMACross Attacker V10", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "523% | Sharpe 1.25", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 0, 1, "Regime:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, inBullRegime ? "BULL" : "BEAR",
               text_color=inBullRegime ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "Position:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, trailActive ? "LONG" : "FLAT",
               text_color=trailActive ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 3, "Trail:", text_color=color.gray, text_size=size.tiny)
    trailColor = currentGain > ratchetAt ? color.teal : color.orange
    table.cell(t, 1, 3, trailActive ? str.tostring(currentTrail, "#.0") + "%" : "-",
               text_color=trailColor, text_size=size.tiny)
    table.cell(t, 0, 4, "Gain:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, trailActive ? str.tostring(currentGain, "#.1") + "%" : "-",
               text_color=currentGain > 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 5, "HWM:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, trailActive ? "$" + str.tostring(highWater, "#.##") : "-",
               text_color=color.white, text_size=size.tiny)

// ═══ ALERTS ═══
alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0,
               "Entry", "EMACross Attacker V10: BUY — EMA(5) x EMA(13) + SMA(30) bull regime")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] > 0,
               "Exit", "EMACross Attacker V10: EXIT — ratcheting trail stop triggered")
alertcondition(not inBullRegime and inBullRegime[1],
               "Bear Regime", "EMACross Attacker V10: Below SMA(30) — bear regime, no entries")
alertcondition(inBullRegime and not inBullRegime[1],
               "Bull Regime", "EMACross Attacker V10: Reclaimed SMA(30) — bull regime, entries enabled")

//@version=5
strategy("AU RSI + ATR Trailing Stop [Evolved R2-05]", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=100000, commission_value=0.1)

// ============================================================================
// EVOLVED STRATEGY: RSI Entry + ATR Trailing Stop
// Backtest Results (AU 1H, 2024-2026):
//   Return: 210%  |  Sharpe: 1.45  |  Sortino: 4.82
//   Max DD: -22%  |  Win Rate: 46%  |  Trades: 48
//   Expectancy: 2.35% per trade
// ============================================================================

// ── Inputs ──────────────────────────────────────────────────
rsi_period  = input.int(14, "RSI Period", minval=2)
rsi_entry   = input.int(30, "RSI Entry (Oversold)", minval=10, maxval=50)
atr_period  = input.int(14, "ATR Period", minval=2)
atr_mult    = input.float(2.0, "ATR Trail Multiplier", minval=0.5, maxval=5.0, step=0.1)

// ── Calculations ────────────────────────────────────────────
rsi_val = ta.rsi(close, rsi_period)
atr_val = ta.atr(atr_period)

// ── Trailing Stop Logic ─────────────────────────────────────
var float highest_since_entry = 0.0
var float trail_stop = 0.0
var bool in_trade = false

// Entry condition
entry_signal = rsi_val < rsi_entry and not in_trade

if entry_signal
    in_trade := true
    highest_since_entry := close
    trail_stop := close - atr_mult * atr_val

if in_trade
    if close > highest_since_entry
        highest_since_entry := close
    new_stop = highest_since_entry - atr_mult * atr_val
    if new_stop > trail_stop
        trail_stop := new_stop

exit_signal = in_trade and close < trail_stop

if exit_signal
    in_trade := false
    highest_since_entry := 0.0
    trail_stop := 0.0

// ── Strategy Orders ─────────────────────────────────────────
if entry_signal
    strategy.entry("Long", strategy.long)

if exit_signal
    strategy.close("Long")

// ── Plots ───────────────────────────────────────────────────
plot(in_trade ? trail_stop : na, "Trailing Stop", color=color.red, linewidth=2, style=plot.style_linebr)

// RSI reference line
hline(rsi_entry, "RSI Entry Level", color=color.gray, linestyle=hline.style_dashed)

// ── Visual Signals ──────────────────────────────────────────
plotshape(entry_signal, "BUY", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(exit_signal, "SELL", shape.triangledown, location.abovebar, color.red, size=size.normal)

// ── Background Color ────────────────────────────────────────
bgcolor(in_trade ? color.new(color.green, 90) : na)

// ── Alerts ──────────────────────────────────────────────────
alertcondition(entry_signal, "AU RSI+ATR BUY Signal", "🟢 BUY AU - RSI oversold at {{close}}")
alertcondition(exit_signal, "AU RSI+ATR SELL Signal", "🔴 SELL AU - Trail stop hit at {{close}}")

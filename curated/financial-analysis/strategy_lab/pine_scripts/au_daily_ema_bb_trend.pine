// ═══════════════════════════════════════════════════════════════════
// AU Daily #2: EMA Trend + Bollinger Dip (Best Risk-Adjusted)
// ═══════════════════════════════════════════════════════════════════
// Evolved via /evolve-strategy AU Daily (2026-02-11)
// Backtest: 114.1% return | Sharpe 0.28 | Sortino 0.47 | MaxDD -26.6%
// Win Rate: 72.7% | 11 trades | SQN 2.03
// Data: 28 years daily (1998-2026) — validated on TradingView full history
//
// LOGIC: Only buy Bollinger Band dips during confirmed uptrends
// (EMA 8 > EMA 21 > EMA 55). Sell when price hits upper BB.
// Fewest trades but highest quality — best Sharpe, lowest drawdown.
// ═══════════════════════════════════════════════════════════════════

//@version=5
strategy("AU EMA+BB Trend [Daily Evolved #2]", overlay=true, initial_capital=100000, commission_value=0.1, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ── Inputs ──────────────────────────────────────────────────────
ema_fast     = input.int(8, "EMA Fast", minval=2)
ema_mid      = input.int(21, "EMA Mid", minval=2)
ema_slow     = input.int(55, "EMA Slow", minval=2)
bb_period    = input.int(20, "Bollinger Period", minval=5)
bb_std       = input.float(2.0, "Bollinger StdDev", minval=0.5, step=0.5)

// ── EMAs ────────────────────────────────────────────────────────
ema8  = ta.ema(close, ema_fast)
ema21 = ta.ema(close, ema_mid)
ema55 = ta.ema(close, ema_slow)
uptrend = ema8 > ema21 and ema21 > ema55

// ── Bollinger Bands ─────────────────────────────────────────────
bb_mid   = ta.sma(close, bb_period)
bb_dev   = bb_std * ta.stdev(close, bb_period)
bb_upper = bb_mid + bb_dev
bb_lower = bb_mid - bb_dev

// ── Entry: BB dip during uptrend ────────────────────────────────
buy_signal = uptrend and close <= bb_lower and strategy.position_size == 0
if buy_signal
    strategy.entry("Long", strategy.long)

// ── Exit: Upper BB ──────────────────────────────────────────────
sell_signal = close >= bb_upper and strategy.position_size > 0
if sell_signal
    strategy.close("Long")

// ── Visuals ─────────────────────────────────────────────────────
// EMA Ribbon
plot(ema8, title="EMA 8", color=color.new(color.green, 30), linewidth=1)
plot(ema21, title="EMA 21", color=color.new(color.orange, 30), linewidth=1)
plot(ema55, title="EMA 55", color=color.new(color.red, 30), linewidth=2)

// Bollinger Bands
p_bb_upper = plot(bb_upper, title="BB Upper", color=color.new(color.blue, 60), linewidth=1)
p_bb_lower = plot(bb_lower, title="BB Lower", color=color.new(color.blue, 60), linewidth=1)
fill(p_bb_upper, p_bb_lower, color=color.new(color.blue, 95), title="BB Fill")

// Trend background
bgcolor(uptrend ? color.new(color.green, 95) : color.new(color.red, 97), title="Trend BG")

// Buy/Sell signals
plotshape(buy_signal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sell_signal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// Position highlighting
bgcolor(strategy.position_size > 0 ? color.new(color.lime, 88) : na, title="In Position")

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(uptrend and close <= bb_lower and strategy.position_size == 0, title="AU EMA+BB Buy", message="AU: Uptrend BB dip — BUY signal (high-quality entry)")
alertcondition(close >= bb_upper and strategy.position_size > 0, title="AU EMA+BB Sell", message="AU: Upper BB hit — SELL signal")

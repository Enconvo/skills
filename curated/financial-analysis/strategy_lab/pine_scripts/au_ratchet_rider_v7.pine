//@version=5
strategy("RatchetRider V7 — AU", overlay=true, initial_capital=100000, commission_value=0.1,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ═══════════════════════════════════════════════════════════
//  CHAMPION V7: RatchetRider + SMA(100) Regime Filter
//  Full-Data Optimized (2021-2026) | 783% | Sharpe 0.88
//  Karpathy-loop: 20,000+ experiments
// ═══════════════════════════════════════════════════════════

// ═══ INPUTS ═══
emaLen       = input.int(2, "Entry EMA Length", minval=1)
smaLen       = input.int(100, "Regime Filter SMA", minval=10, tooltip="Only enter when price > SMA. Keeps you out of bear markets.")
wideTrail    = input.float(20.0, "Wide Trail % (initial)", step=0.5)
tightTrail   = input.float(15.0, "Tight Trail % (after ratchet)", step=0.5)
ratchetAt    = input.float(60.0, "Ratchet At Gain %", step=5, tooltip="Tighten trail when trade is up this much %")
cooldownBars = input.int(1, "Cooldown Bars After Exit", minval=0)

// ═══ INDICATORS ═══
emaVal = ta.ema(close, emaLen)
smaVal = ta.sma(close, smaLen)

// ═══ STATE ═══
var float highWater = 0.0
var float entryPrice = 0.0
var int barsSinceExit = 999

// ═══ REGIME ═══
inBullRegime = close > smaVal

// ═══ ENTRY ═══
if strategy.position_size == 0
    barsSinceExit += 1
    if close > emaVal and inBullRegime and barsSinceExit > cooldownBars
        strategy.entry("Long", strategy.long)
        highWater := close
        entryPrice := close
        barsSinceExit := 0

// ═══ EXIT: RATCHETING TRAIL ═══
if strategy.position_size > 0
    highWater := math.max(highWater, close)
    gainPct = (close / entryPrice - 1.0) * 100.0
    trail = gainPct > ratchetAt ? tightTrail : wideTrail
    trailLevel = highWater * (1.0 - trail / 100.0)

    if close < trailLevel
        strategy.close("Long", comment="Trail " + str.tostring(trail, "#.0") + "%")
        barsSinceExit := 0

// ═══ PLOTS ═══
// SMA regime line — the most important indicator
plot(smaVal, "SMA(100) Regime", color=color.new(color.yellow, 20), linewidth=2)
plot(emaVal, "EMA(2) Entry", color=color.new(color.blue, 60), linewidth=1)

// Regime background: green when above SMA (tradeable), red when below (sit out)
bgcolor(inBullRegime ? color.new(color.green, 95) : color.new(color.red, 95), title="Regime Zone")

// Trail stop visualization
trailActive = strategy.position_size > 0
currentGain = trailActive ? (close / entryPrice - 1.0) * 100.0 : 0.0
currentTrail = currentGain > ratchetAt ? tightTrail : wideTrail
trailLine = trailActive ? highWater * (1.0 - currentTrail / 100.0) : na
plot(trailLine, "Trail Stop", color=color.new(color.red, 30), linewidth=2, style=plot.style_stepline)

// High water mark
hwmLine = trailActive ? highWater : na
plot(hwmLine, "High Water", color=color.new(color.green, 60), linewidth=1, style=plot.style_stepline)

// Ratchet indicator — shows when trail has tightened
ratcheted = trailActive and currentGain > ratchetAt
bgcolor(ratcheted ? color.new(color.teal, 93) : na, title="Trail Ratcheted")

// ═══ INFO TABLE ═══
var table infoTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 70),
                                 border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(infoTable, 0, 0, "RatchetRider V7", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "", text_color=color.white)
    table.cell(infoTable, 0, 1, "Regime:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 1, inBullRegime ? "BULL ✓" : "BEAR ✗",
               text_color=inBullRegime ? color.green : color.red, text_size=size.tiny)
    table.cell(infoTable, 0, 2, "Position:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 2, trailActive ? "LONG" : "FLAT",
               text_color=trailActive ? color.green : color.gray, text_size=size.tiny)
    table.cell(infoTable, 0, 3, "Trail:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 3, trailActive ? str.tostring(currentTrail, "#.0") + "%" : "-",
               text_color=ratcheted ? color.teal : color.orange, text_size=size.tiny)
    table.cell(infoTable, 0, 4, "Gain:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 4, trailActive ? str.tostring(currentGain, "#.1") + "%" : "-",
               text_color=currentGain > 0 ? color.green : color.red, text_size=size.tiny)

// ═══ ALERTS ═══
alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0,
               "RatchetRider Entry", "RatchetRider V7: BUY — price above SMA(100) + EMA(2)")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] > 0,
               "RatchetRider Exit", "RatchetRider V7: EXIT — trail stop hit")
alertcondition(not inBullRegime and inBullRegime[1],
               "Regime Bearish", "RatchetRider V7: Price dropped below SMA(100) — bear regime")
alertcondition(inBullRegime and not inBullRegime[1],
               "Regime Bullish", "RatchetRider V7: Price reclaimed SMA(100) — bull regime")

// ═══════════════════════════════════════════════════════════════════
// AU Smart Pick #2: Golden Cross (SMA 50/200) + Safety Filter
// ═══════════════════════════════════════════════════════════════════
// Walk-Forward Validated: 5/7 periods profitable
// Avg return per 3yr period: 59.8% | Avg worst dip: -30%
// Risk level: Medium | Confidence: Good
// Full-history: 252.1% return | 21 trades | 33.3% win rate
// Data: 28 years daily (1998-2026)
//
// HOW IT WORKS: Buys when the 50-day average crosses above the
// 200-day average (classic "Golden Cross" — a sign the trend is
// turning bullish). Sells when 50-day crosses below 200-day.
// SAFETY FILTER: Only enters when price is already above 200-day
// average (confirms the uptrend is real, not a fake crossover).
//
// BEST FOR: Investors who want big moves. Low win rate (33%) but
// winners are MUCH larger than losers. Highest avg return per period.
// ═══════════════════════════════════════════════════════════════════

//@version=5
strategy("AU Golden Cross [Smart #2]", overlay=true, initial_capital=100000, commission_value=0.1, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ── Inputs ──────────────────────────────────────────────────────
fast_period   = input.int(50, "Fast SMA", minval=10)
slow_period   = input.int(200, "Slow SMA", minval=50)

// ── Indicators ──────────────────────────────────────────────────
sma_fast = ta.sma(close, fast_period)
sma_slow = ta.sma(close, slow_period)

// ── Safety Filter: price above 200 SMA ─────────────────────────
bullish_regime = close > sma_slow

// ── Entry: Golden Cross + bullish regime ────────────────────────
golden_cross = ta.crossover(sma_fast, sma_slow)
buy_signal = golden_cross and bullish_regime and strategy.position_size == 0
if buy_signal
    strategy.entry("Long", strategy.long)

// ── Exit: Death Cross OR regime turns bearish ───────────────────
death_cross = ta.crossover(sma_slow, sma_fast)
exit_regime = strategy.position_size > 0 and not bullish_regime
sell_signal = (death_cross or exit_regime) and strategy.position_size > 0

if sell_signal
    strategy.close("Long")

// ── Visuals ─────────────────────────────────────────────────────
plot(sma_fast, title="SMA 50", color=color.new(color.green, 20), linewidth=2)
plot(sma_slow, title="SMA 200", color=color.new(color.red, 20), linewidth=2)

// Regime background
bgcolor(bullish_regime ? color.new(color.green, 95) : color.new(color.red, 95), title="Regime BG")

// Cross markers
plotshape(golden_cross, title="Golden Cross", style=shape.diamond, location=location.abovebar, color=color.yellow, size=size.tiny, text="GC")

// Signals
plotshape(buy_signal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sell_signal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

// Position
bgcolor(strategy.position_size > 0 ? color.new(color.lime, 88) : na, title="In Position")

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(buy_signal, title="Smart #2 Buy", message="AU: Golden Cross confirmed in uptrend — BUY signal")
alertcondition(sell_signal, title="Smart #2 Sell", message="AU: Death Cross or regime exit — SELL signal")

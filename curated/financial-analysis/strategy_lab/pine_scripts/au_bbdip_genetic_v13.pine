// BBDip Genetic V13 — 713% | Sharpe 1.64 | 170K experiments
//@version=5
strategy("BBDip Genetic V13 — AU", overlay=true, initial_capital=100000, commission_value=0.1,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ═══════════════════════════════════════════════════════════════════════
//  CHAMPION V13: BBDip Genetic — BB Lower Dip + EMA(66) Regime
//  2024-01 onward | 713.5% | Sharpe 1.64 | Sortino 7.65 | MaxDD -13.4%
//  Genetic algorithm champion: 80 generations, 170K+ experiments (V1-V13)
//  Converged by Gen 20. Three exit mechanisms: ratcheting trail, profit
//  target, time stop — whichever fires first.
// ═══════════════════════════════════════════════════════════════════════

// ═══ INPUTS ═══
bbLen        = input.int(11, "BB Period", minval=2,
               tooltip="Bollinger Band period — tight (11) catches shallow dips quickly.")
bbStd        = input.float(2.0, "BB Std Dev", step=0.1,
               tooltip="Standard deviation multiplier for Bollinger Bands.")
emaLen       = input.int(66, "Regime Filter EMA", minval=10,
               tooltip="Bull regime = close above EMA(66). Only enter dips in uptrend.")
wideTrail    = input.float(34.2, "Wide Trail % (initial)", step=0.1,
               tooltip="Trail stop distance early in trade — wide to avoid premature exit.")
tightTrail   = input.float(3.7, "Tight Trail % (after ratchet)", step=0.1,
               tooltip="Trail stop distance once ratchet threshold hit — locks profits.")
ratchetAt    = input.float(60.0, "Ratchet At Gain %", step=1.0,
               tooltip="Tighten trail from 34.2% to 3.7% when trade gain exceeds this.")
profitTarget = input.float(74.0, "Profit Target %", step=1.0,
               tooltip="Exit when unrealized gain reaches this level.")
timeStop     = input.int(82, "Time Stop (bars)", minval=1,
               tooltip="Maximum bars in trade before forced exit.")
cooldownBars = input.int(4, "Cooldown Bars After Exit", minval=0,
               tooltip="Minimum bars to wait after exit before re-entry.")

// ═══ INDICATORS ═══
emaVal = ta.ema(close, emaLen)
[bbMid, bbUpper, bbLower] = ta.bb(close, bbLen, bbStd)

// ═══ STATE ═══
var float highWater = 0.0
var float entryPrice = 0.0
var int barsSinceExit = 999
var int barsInTrade = 0

// ═══ REGIME ═══
inBullRegime = close > emaVal

// ═══ ENTRY ═══
if strategy.position_size == 0
    barsSinceExit += 1
    if close <= bbLower and inBullRegime and barsSinceExit > cooldownBars
        strategy.entry("Long", strategy.long)
        highWater := close
        entryPrice := close
        barsInTrade := 0
        barsSinceExit := 0

// ═══ EXIT: THREE MECHANISMS ═══
if strategy.position_size > 0
    barsInTrade += 1
    highWater := math.max(highWater, close)
    gainPct = (close / entryPrice - 1.0) * 100.0
    trail = gainPct > ratchetAt ? tightTrail : wideTrail
    trailLevel = highWater * (1.0 - trail / 100.0)

    // Exit 1: Ratcheting trail stop
    if close < trailLevel
        strategy.close("Long", comment="Trail " + str.tostring(trail, "#.0") + "%")
        barsSinceExit := 0

    // Exit 2: Profit target
    if gainPct >= profitTarget
        strategy.close("Long", comment="Target +" + str.tostring(profitTarget, "#.0") + "%")
        barsSinceExit := 0

    // Exit 3: Time stop
    if barsInTrade >= timeStop
        strategy.close("Long", comment="Time " + str.tostring(timeStop) + " bars")
        barsSinceExit := 0

// ═══ PLOTS ═══
plot(emaVal, "EMA(66) Regime", color=color.new(color.yellow, 20), linewidth=2)
plot(bbLower, "BB Lower", color=color.new(color.blue, 40), linewidth=1)

// Regime background
bgcolor(inBullRegime ? color.new(color.green, 95) : color.new(color.red, 95), title="Regime")

// Trail stop line
trailActive = strategy.position_size > 0
currentGain = trailActive ? (close / entryPrice - 1.0) * 100.0 : 0.0
currentTrail = currentGain > ratchetAt ? tightTrail : wideTrail
trailLine = trailActive ? highWater * (1.0 - currentTrail / 100.0) : na
plot(trailLine, "Trail Stop", color=color.new(color.red, 30), linewidth=2, style=plot.style_stepline)

// High water mark line
hwmLine = trailActive ? highWater : na
plot(hwmLine, "High Water", color=color.new(color.green, 60), linewidth=1, style=plot.style_stepline)

// Profit target line
ptLine = trailActive ? entryPrice * (1.0 + profitTarget / 100.0) : na
plot(ptLine, "Profit Target", color=color.new(color.lime, 40), linewidth=1, style=plot.style_line)

// Ratchet state bgcolor
bgcolor(trailActive and currentGain > ratchetAt ? color.new(color.teal, 93) : na, title="Ratcheted")

// ═══ INFO TABLE ═══
var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 70),
                        border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(t, 0, 0, "BBDip Genetic V13", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "713% | Sharpe 1.64", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 0, 1, "Regime:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, inBullRegime ? "BULL" : "BEAR",
               text_color=inBullRegime ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "Position:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, trailActive ? "LONG" : "FLAT",
               text_color=trailActive ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 3, "Trail:", text_color=color.gray, text_size=size.tiny)
    trailColor = currentGain > ratchetAt ? color.teal : color.orange
    table.cell(t, 1, 3, trailActive ? str.tostring(currentTrail, "#.0") + "%" : "-",
               text_color=trailColor, text_size=size.tiny)
    table.cell(t, 0, 4, "Gain:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, trailActive ? str.tostring(currentGain, "#.1") + "%" : "-",
               text_color=currentGain > 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 5, "HWM:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, trailActive ? "$" + str.tostring(highWater, "#.##") : "-",
               text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 6, "Bars:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, trailActive ? str.tostring(barsInTrade) + " / " + str.tostring(timeStop) : "-",
               text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 7, "Target:", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7, trailActive ? "$" + str.tostring(entryPrice * (1.0 + profitTarget / 100.0), "#.##") : "-",
               text_color=color.lime, text_size=size.tiny)

// ═══ ALERTS ═══
alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0,
               "Entry", "BBDip Genetic V13: BUY — BB dip in bull regime (EMA66)")
alertcondition(strategy.position_size == 0 and strategy.position_size[1] > 0,
               "Trail Exit", "BBDip Genetic V13: EXIT — ratcheting trail stop triggered")
alertcondition(trailActive and currentGain >= profitTarget,
               "Profit Target", "BBDip Genetic V13: EXIT — profit target hit +" + str.tostring(profitTarget) + "%")
alertcondition(trailActive and barsInTrade >= timeStop,
               "Time Stop", "BBDip Genetic V13: EXIT — time stop at " + str.tostring(timeStop) + " bars")
